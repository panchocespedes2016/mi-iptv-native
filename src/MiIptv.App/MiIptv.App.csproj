<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <Version>0.1.8</Version>
    <AssemblyName>mi-iptv-native</AssemblyName>
    <ApplicationIcon>icon.ico</ApplicationIcon>
    <!-- Portable sin instalador: carpeta con el exe + piezas de VLC al lado.
         (single-file no funciona con las DLLs nativas de LibVLCSharp) -->
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <DebugType>none</DebugType>
    <!-- El paquete VideoLAN.LibVLC.Windows no lleva sus DLLs a publish/ por sí solo:
         desactivamos su copia automática y la declaramos explícita abajo. -->
    <VlcWindowsX64Enabled>false</VlcWindowsX64Enabled>
    <VlcWindowsX86Enabled>false</VlcWindowsX86Enabled>
  </PropertyGroup>

  <ItemGroup>
    <!-- DLLs nativas de VLC (x64) junto al exe -->
    <Content Include="$(PkgVideoLAN_LibVLC_Windows)\build\x64\**">
      <Link>libvlc\win-x64\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="LibVLCSharp.WPF" Version="3.8.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MiIptv.Core\MiIptv.Core.csproj" />
  </ItemGroup>

</Project>
