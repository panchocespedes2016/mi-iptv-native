<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <Version>0.1.9</Version>
    <AssemblyName>mi-iptv-native</AssemblyName>
    <ApplicationIcon>icon.ico</ApplicationIcon>
    <!-- Portable sin instalador: carpeta con el exe + piezas de VLC al lado.
         (single-file no funciona con las DLLs nativas de LibVLCSharp) -->
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <DebugType>none</DebugType>
    <!-- El paquete VideoLAN.LibVLC.Windows no lleva sus DLLs a publish/ por sí solo:
         desactivamos su copia automática y la declaramos explícita abajo. -->
    <VlcWindowsX64Enabled>false</VlcWindowsX64Enabled>
    <VlcWindowsX86Enabled>false</VlcWindowsX86Enabled>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="LibVLCSharp.WPF" Version="3.8.1" />
    <!-- Nativos de VLC: referencia directa (LibVLCSharp no la trae transitiva) -->
    <PackageReference Include="VideoLAN.LibVLC.Windows" Version="3.0.24" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MiIptv.Core\MiIptv.Core.csproj" />
  </ItemGroup>

</Project>
