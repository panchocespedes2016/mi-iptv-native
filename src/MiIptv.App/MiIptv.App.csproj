<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <Version>0.1.6</Version>
    <AssemblyName>mi-iptv-native</AssemblyName>
    <ApplicationIcon>icon.ico</ApplicationIcon>
    <!-- Portable sin instalador: carpeta con el exe + piezas de VLC al lado.
         (single-file no funciona con las DLLs nativas de LibVLCSharp) -->
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="LibVLCSharp.WPF" Version="3.8.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MiIptv.Core\MiIptv.Core.csproj" />
  </ItemGroup>

</Project>
