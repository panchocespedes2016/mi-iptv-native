<Window x:Class="MiIptv.App.Views.MovieDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Película" Height="520" Width="760" WindowStartupLocation="CenterScreen"
        Background="{StaticResource Bg}" Foreground="{StaticResource Fg}"
        Loaded="Window_Loaded">
  <Grid Margin="16">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="220"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>
    <Image x:Name="Poster" Width="200" Stretch="Uniform" VerticalAlignment="Top"/>
    <StackPanel Grid.Column="1" Margin="16,0,0,0">
      <TextBlock x:Name="TitleLabel" FontSize="22" FontWeight="Bold" TextWrapping="Wrap"/>
      <TextBlock x:Name="MetaLabel" Foreground="{StaticResource Muted}" Margin="0,6"/>
      <TextBlock x:Name="PlotLabel" TextWrapping="Wrap" Margin="0,6"/>
      <TextBlock x:Name="CastLabel" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,6"/>
      <Button x:Name="PlayBtn" Content="▶ Reproducir" Click="Play_Click"
              HorizontalAlignment="Left" Margin="0,16" Padding="20,10" FontSize="15"/>
      <TextBlock x:Name="StatusLabel" Foreground="{StaticResource Muted}"/>
    </StackPanel>
  </Grid>
</Window>
