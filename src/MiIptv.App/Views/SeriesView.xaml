<UserControl x:Class="MiIptv.App.Views.SeriesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="UserControl_Loaded">
  <DockPanel>
    <StackPanel DockPanel.Dock="Top">
      <TextBox x:Name="SearchBox" TextChanged="Search_Changed" Margin="4"/>
      <ScrollViewer MaxHeight="100" VerticalScrollBarVisibility="Auto">
        <WrapPanel x:Name="CatPanel" Margin="4"/>
      </ScrollViewer>
      <TextBlock x:Name="StatusLabel" Foreground="{StaticResource Muted}" Margin="8,0"/>
    </StackPanel>
    <ListBox x:Name="Grid" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
             SelectionChanged="Grid_Activated">
      <ListBox.ItemsPanel>
        <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
      </ListBox.ItemsPanel>
      <ListBox.ItemTemplate>
        <DataTemplate>
          <StackPanel Width="150" Margin="6" Cursor="Hand">
            <Image Source="{Binding Logo}" Width="150" Height="220" Stretch="UniformToFill"/>
            <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="12"
                       TextTrimming="CharacterEllipsis" MaxHeight="36" TextWrapping="Wrap"/>
            <TextBlock Text="{Binding Sub}" Foreground="{StaticResource Muted}" FontSize="11"/>
          </StackPanel>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
  </DockPanel>
</UserControl>
