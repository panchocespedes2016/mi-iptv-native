<Window x:Class="MiIptv.App.Views.PlayerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
        Title="MiIPTV" WindowState="Maximized" WindowStyle="None"
        Background="Black" KeyDown="Window_KeyDown" MouseMove="Window_MouseMove">
  <Grid>
    <vlc:VideoView x:Name="VideoView" />

    <Border x:Name="TopBar" VerticalAlignment="Top" Background="#CC000000" Padding="12,8">
      <DockPanel>
        <TextBlock x:Name="TitleLabel" FontSize="16" FontWeight="Bold"
                   VerticalAlignment="Center" Foreground="White"/>
        <Button DockPanel.Dock="Right" Content="✕ Cerrar" Click="Close_Click"/>
      </DockPanel>
    </Border>

    <Border x:Name="BottomBar" VerticalAlignment="Bottom" Background="#CC000000" Padding="12,8">
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <Button x:Name="PlayPauseBtn" Content="⏸" Click="PlayPause_Click" FontSize="16" MinWidth="48"/>
        <Button Content="⏹" Click="Stop_Click" FontSize="16" MinWidth="48"/>
        <TextBlock Text="🔊" VerticalAlignment="Center" Margin="12,0,4,0" Foreground="White"/>
        <Slider x:Name="VolumeSlider" Minimum="0" Maximum="100" Value="100" Width="140"
                VerticalAlignment="Center" ValueChanged="Volume_Changed"/>
        <Button Content="⛶" Click="Fullscreen_Click" FontSize="16" MinWidth="48" Margin="12,0,0,0"/>
      </StackPanel>
    </Border>
  </Grid>
</Window>
