<Window x:Class="MiIptv.App.Views.SeriesDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Serie" Height="620" Width="860" WindowStartupLocation="CenterScreen"
        Background="{StaticResource Bg}" Foreground="{StaticResource Fg}"
        Loaded="Window_Loaded">
  <Grid Margin="16">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="200"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>
    <StackPanel>
      <Image x:Name="Cover" Width="180" Stretch="Uniform" VerticalAlignment="Top"/>
    </StackPanel>
    <DockPanel Grid.Column="1" Margin="16,0,0,0">
      <StackPanel DockPanel.Dock="Top">
        <TextBlock x:Name="TitleLabel" FontSize="22" FontWeight="Bold" TextWrapping="Wrap"/>
        <TextBlock x:Name="MetaLabel" Foreground="{StaticResource Muted}" Margin="0,6" TextWrapping="Wrap"/>
        <TextBlock x:Name="PlotLabel" TextWrapping="Wrap" Margin="0,6"/>
        <StackPanel Orientation="Horizontal" Margin="0,8">
          <TextBlock Text="Temporada:" VerticalAlignment="Center" Margin="0,0,8,0"/>
          <ComboBox x:Name="SeasonBox" SelectionChanged="Season_Changed" MinWidth="120"/>
        </StackPanel>
      </StackPanel>
      <TextBlock x:Name="StatusLabel" DockPanel.Dock="Bottom" Foreground="{StaticResource Muted}"/>
      <ListBox x:Name="EpisodeList" SelectionChanged="Episode_Activated">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <StackPanel Margin="4">
              <TextBlock Text="{Binding Title}" FontWeight="Bold"/>
              <TextBlock Text="{Binding Sub}" Foreground="{StaticResource Muted}"
                         FontSize="12" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </DockPanel>
  </Grid>
</Window>
